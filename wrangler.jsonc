{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ping",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": false },
  "routes": [{ "pattern": "ping.r3.net.eu.org", "custom_domain": true }],
}
